# Copy to backend/.env and fill in. Items marked TODO require an external
# account/key before that feature works; the app runs without them (those
# features degrade gracefully).

# ── Required ──────────────────────────────────────────────────────────────
# Generate SECRET_KEY:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
# Generate FERNET_KEY:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=change-me
DATABASE_URL=postgresql://localhost/bank_aggregator

# ── Plaid (account connections) ───────────────────────────────────────────
# TODO: create a Plaid account at https://dashboard.plaid.com and paste keys.
#       PLAID_ENV=sandbox works with test creds (user_good / pass_good).
#       For real banks: complete Plaid's Production access request, then set
#       PLAID_ENV=production and swap in the production keys.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# TODO: set to a PUBLIC https URL of /plaid/webhook to enable auto-sync on new
#       transactions (e.g. https://api.yourdomain.com/plaid/webhook).
PLAID_WEBHOOK_URL=

# ── Auth / cookies (production) ───────────────────────────────────────────
ENVIRONMENT=development          # set to "production" to enable HSTS
FRONTEND_URL=http://localhost:3000
COOKIE_SECURE=false              # TODO: true behind HTTPS in production
COOKIE_SAMESITE=lax              # "none" (with COOKIE_SECURE=true) for cross-site frontends
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Rate limiting (auth endpoints) ────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=300

# ── Stripe (Premium subscriptions) — optional ────────────────────────────
# TODO: create a Stripe account, a recurring Price, and a webhook endpoint
#       (event checkout.session.completed + customer.subscription.deleted) at
#       /billing/webhook. Without these, the upgrade flow returns 503.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# ── Anthropic (AI advisor) — optional ─────────────────────────────────────
# TODO: get an API key at https://console.anthropic.com. Without it the
#       advisor is disabled (returns 503) and the UI shows a "not enabled" note.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
